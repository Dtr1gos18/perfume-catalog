---
interface Props {
  color: string;
  width: number;
  height: number;
  radius: string;
}

const { color, width, height, radius } = Astro.props;
// El tamaño base se amplía para llenar el panel de la card.
const scale = 1.6;
const scaled = radius.replace(/(\d+)px/g, (_, n) => `${Math.round(Number(n) * scale)}px`);
---

<!-- Frasco dibujado con CSS: se usa mientras un perfume no tiene foto. Decorativo. -->
<div aria-hidden="true" class="flex flex-col items-center">
  <div class="h-[22px] w-7 rounded-md border-2 border-ink bg-gold"></div>
  <div
    class="border-2 border-ink"
    style={`width:${Math.round(width * scale)}px;height:${Math.round(height * scale)}px;border-radius:${scaled};background:${color}`}
  ></div>
</div>
