---
interface Props {
  bg: string;
  color: string;
  width: number;
  height: number;
  radius: string;
}

const { bg, color, width, height, radius } = Astro.props;
---

<!-- Frasco dibujado con CSS: se usa mientras un perfume no tiene foto. Decorativo. -->
<div
  aria-hidden="true"
  class="flex size-[110px] shrink-0 items-center justify-center rounded-[18px] border-2 border-ink"
  style={`background:${bg}`}
>
  <div class="flex flex-col items-center">
    <div class="h-3.5 w-[18px] rounded border-[1.5px] border-ink bg-gold"></div>
    <div
      class="border-[1.5px] border-ink"
      style={`width:${width}px;height:${height}px;border-radius:${radius};background:${color}`}
    ></div>
  </div>
</div>
