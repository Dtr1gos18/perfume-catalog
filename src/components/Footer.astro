---
import Logo from './Logo.astro';
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t-2 border-ink">
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-6 px-5 py-6 text-sm text-muted sm:px-8">
    <Logo height={64} />
    <span>
      © {year} {site.name}
    </span>
  </div>
</footer>
