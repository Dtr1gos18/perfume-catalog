---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import diamantes from '../assets/logo-diamantes.jpg';
import badboy from '../assets/logo-badboy.png';

interface Props {
  /** Alto en px; el ancho sale de la proporción de cada logo. */
  height: number;
  eager?: boolean;
  class?: string;
}

const logos = { diamantes, badboy };
const logo = logos[site.id];

const { height, eager = false, class: className } = Astro.props;
---

<Image
  src={logo}
  alt={site.name}
  width={Math.round((height * logo.width) / logo.height)}
  height={height}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['block h-auto w-auto', className]}
  style={`height:${height}px`}
/>
