---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BottlePlaceholder from './BottlePlaceholder.astro';
import IntensityMeter from './IntensityMeter.astro';
import { resolveIntensity } from '../lib/intensity';
import { findPerfumeImage } from '../lib/perfume-images';

interface Props {
  perfume: CollectionEntry<'perfumes'>;
}

const { perfume } = Astro.props;
const { id: code, data } = perfume;
const { name, family, gender, notes, concentration, bottle } = data;
const intensity = resolveIntensity(data.intensity, concentration);
// Etiqueta bajo la barra: deja claro de dónde sale el valor (nunca pasa por dato oficial).
const intensityLabel =
  data.intensityBasis === 'estimada'
    ? 'Estimada'
    : data.intensityBasis === 'resenas'
      ? concentration
        ? `${concentration} · según reseñas`
        : 'Según reseñas'
      : concentration;
// `image` explícito en el JSON > foto con nombre <codigo>.<ext> en src/assets/perfumes
const image = data.image ?? findPerfumeImage(code);

// Frasco de relleno por género mientras no haya foto.
const fallbackBottles = {
  Hombre: { bg: '#DDEBF5', color: '#3F5E8C', width: 48, height: 52, radius: '5px' },
  Mujer: { bg: '#FFD6E3', color: '#E2457A', width: 42, height: 58, radius: '21px 21px 8px 8px' },
  Unisex: { bg: '#F8E6C8', color: '#D9963F', width: 44, height: 56, radius: '8px' },
} as const;

const noteItems = [
  { label: 'Salida', value: notes?.top },
  { label: 'Corazón', value: notes?.heart },
  { label: 'Fondo', value: notes?.base },
].filter((note) => note.value);
---

<article
  data-item
  data-code={code}
  data-name={name}
  data-item-gender={gender}
  class="flex flex-wrap items-center gap-x-7 gap-y-5 border-b-2 border-ink px-5 py-5 sm:px-6"
>
  <span class="flex-[0_0_96px] text-5xl leading-none font-bold tracking-[-0.05em]">{code}</span>

  {image ? (
    <Image
      src={image}
      alt={`Frasco del perfume ${name}`}
      width={110}
      height={110}
      densities={[1, 2]}
      loading="lazy"
      class="size-[110px] shrink-0 rounded-[18px] border-2 border-ink bg-white object-contain"
    />
  ) : (
    <BottlePlaceholder {...(bottle ?? fallbackBottles[gender])} />
  )}

  <div class="min-w-0 flex-[1_1_220px]">
    <h3 class="mb-1.5 font-serif text-[26px] leading-[1.15] font-semibold">{name}</h3>
    <div class="flex flex-wrap gap-1.5">
      {family && (
        <span class="rounded-full border-[1.5px] border-ink bg-blush px-2.5 py-0.5 text-[13px] font-medium">
          {family}
        </span>
      )}
      <span class="rounded-full border-[1.5px] border-ink px-2.5 py-0.5 text-[13px] font-medium">
        {gender}
      </span>
    </div>
  </div>

  {noteItems.length > 0 && (
    <dl class="m-0 grid min-w-0 flex-[2_1_360px] grid-cols-1 gap-3 text-[15px] sm:grid-cols-3">
      {noteItems.map((note) => (
        <div>
          <dt class="text-xs font-bold tracking-[0.08em] text-subtle uppercase">{note.label}</dt>
          <dd class="mt-0.5">{note.value}</dd>
        </div>
      ))}
    </dl>
  )}

  {noteItems.length === 0 && data.description && (
    <div class="min-w-0 flex-[2_1_360px]">
      <p class="mb-0.5 text-xs font-bold tracking-[0.08em] text-subtle uppercase">
        Características
      </p>
      <p class="m-0 text-[15px]">{data.description}</p>
    </div>
  )}

  {intensity && (
    <div class="flex-[0_0_150px]">
      <p class="mb-1.5 text-xs font-bold tracking-[0.08em] text-subtle uppercase">Intensidad</p>
      <IntensityMeter level={intensity} />
      {intensityLabel && <p class="mt-1.5 text-xs text-subtle">{intensityLabel}</p>}
    </div>
  )}
</article>
