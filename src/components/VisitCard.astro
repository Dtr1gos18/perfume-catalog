---
import { site, whatsappUrl } from '../config/site';

const { contact } = site;
// En desarrollo se muestran marcadores para ver el diseño completo; en producción se omiten.
const address = contact.address ?? (import.meta.env.DEV ? '[DIRECCIÓN]' : null);
const hours = contact.hours ?? (import.meta.env.DEV ? [{ days: '[HORARIO]', time: '' }] : null);
const whatsapp = whatsappUrl();
---

<section
  id="visitanos"
  aria-labelledby="visitanos-titulo"
  class="mx-auto max-w-[1240px] px-5 pb-24 sm:px-8"
>
  <div class="flex flex-wrap items-center justify-between gap-8 rounded-[32px] border-2 border-ink bg-accent px-6 py-10 text-white shadow-hard-lg sm:px-12 sm:py-14">
    <h2
      id="visitanos-titulo"
      class="m-0 flex-[1_1_460px] font-serif text-[clamp(2rem,5vw,2.875rem)] leading-[1.08] font-normal"
    >
      Tu fragancia ideal <em>te está esperando.</em>
    </h2>

    <div class="flex-[1_1_280px] space-y-4 text-lg font-medium">
      {address && <address class="m-0 not-italic">{address}</address>}

      {hours && (
        <ul class="m-0 list-none space-y-0.5 p-0 text-base">
          {hours.map(({ days, time }) => (
            <li>
              {time ? `${days}: ` : days}
              <span class="whitespace-nowrap">{time}</span>
            </li>
          ))}
        </ul>
      )}

      {whatsapp && (
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[46px] items-center rounded-full border-2 border-ink bg-white px-6 font-bold text-ink shadow-hard-sm transition-shadow hover:bg-ink hover:text-white hover:shadow-none"
        >
          Escríbenos por WhatsApp
        </a>
      )}
    </div>
  </div>
</section>
